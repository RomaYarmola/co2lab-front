# Канонічний домен — використовується для canonical, hreflang, sitemap і JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.co2lab.pro

# Sanity (адмінка контенту — репозиторій co2lab-admin)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Секрет для вебхука ревалідації з Sanity
SANITY_REVALIDATE_SECRET=

# Telegram-нотифікації з форм.
# TELEGRAM_BOT_ID — історична назва тієї самої змінної на Vercel; код читає
# спочатку TELEGRAM_BOT_TOKEN, потім TELEGRAM_BOT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Верифікація в пошукових консолях (необовʼязково)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Аналітика (вмикається лише коли задано id)
# Google Tag Manager — GA4 та конверсії налаштовуються всередині контейнера
NEXT_PUBLIC_GTM_ID=
# Microsoft Clarity — записи сесій і heatmap
NEXT_PUBLIC_CLARITY_ID=

# Пуш каталогу в Sanity (scripts/sanity-push.mts) — токен з правами Editor
SANITY_WRITE_TOKEN=
