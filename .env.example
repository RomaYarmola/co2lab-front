# Канонічний домен — використовується для canonical, hreflang, sitemap і JSON-LD
NEXT_PUBLIC_SITE_URL=https://co2lab.com

# Sanity (адмінка контенту — репозиторій co2lab-admin)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Секрет для вебхука ревалідації з Sanity
SANITY_REVALIDATE_SECRET=

# Telegram-нотифікації з форм
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Верифікація в пошукових консолях (необовʼязково)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
